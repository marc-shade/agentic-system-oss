[Unit]
Description=Cluster Health Monitoring Service
Documentation=https://github.com/agentic-system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentic
Group=agentic
WorkingDirectory=/mnt/agentic-system/intelligent-agents

# Main service executable
ExecStart=/mnt/agentic-system/.venv/bin/python3 /mnt/agentic-system/intelligent-agents/cluster_health_monitor.py

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=0

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/mnt/agentic-system/.venv/bin:/usr/local/bin:/usr/bin:/bin"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cluster-health-monitor

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/agentic-system/logs /mnt/agentic-system/databases /tmp

[Install]
WantedBy=multi-user.target
