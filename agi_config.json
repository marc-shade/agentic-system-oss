{
  "mode": "production",
  "knowledge_acquisition": {
    "use_real_sources": true,
    "research_papers": {
      "enabled": true,
      "queries": [
        "recursive self-improvement AI",
        "autonomous AGI systems",
        "meta-learning optimization",
        "self-modifying code",
        "artificial general intelligence"
      ],
      "max_results_per_query": 2
    },
    "video_transcripts": {
      "enabled": true,
      "queries": [
        "AGI optimization techniques",
        "recursive self-improvement",
        "autonomous AI systems"
      ],
      "max_results_per_query": 1
    },
    "fallback_to_simulated": true
  },
  "target_files": {
    "practice_targets": [
      "intelligent-agents/sample_module.py"
    ],
    "production_targets": [
      "autonomous_recursive_agi_loop.py",
      "intelligent-agents/darwin_godel_machine.py",
      "intelligent-agents/auto_implementation_engine.py",
      "intelligent-agents/knowledge_synthesis_engine.py",
      "intelligent-agents/self_evaluation_system.py",
      "intelligent-agents/sandbox_testing_environment.py",
      "intelligent-agents/multi_agent_coordinator.py",
      "intelligent-agents/agi_orchestrator.py",
      "intelligent-agents/scheduled_health_monitor.py",
      "intelligent-agents/skill_evolution_system.py"
    ],
    "use_production_targets": false,
    "rollout_schedule": {
      "phase": "preparation",
      "monitoring_start": "2025-11-10T12:00:00",
      "enable_after_hours": 24,
      "criteria": {
        "min_successful_cycles": 3,
        "min_success_rate": 0.9,
        "max_safety_incidents": 0,
