    },
    "comment": "Phase 1: Full Self-Bootstrap - All 10 core system files ready. Will enable after 24h successful operation."
  },
  "safety": {
    "sandbox_required": true,
    "git_rollback_enabled": true,
    "confidence_threshold": 0.7,
    "regression_threshold_percent": 10.0,
    "max_improvements_per_cycle": 3
  },
  "timing": {
    "cycle_delay_seconds": 3600,
    "min_knowledge_items": 5
  },
  "monitoring": {
    "log_level": "INFO",
    "prometheus_enabled": true,
    "grafana_enabled": true
  },
  "enable_llm_detection": true,
  "enable_quality_gates": true,
  "enable_rag_integration": true
