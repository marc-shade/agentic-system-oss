{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incremental Features Schema",
  "description": "Schema for tracking incremental development features and tests",
  "type": "object",
  "required": ["project", "features", "metadata"],
  "properties": {
    "project": {
      "type": "string",
      "description": "Project name"
    },
    "description": {
      "type": "string",
      "description": "Project description"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version"
    },
    "config": {
      "type": "object",
      "properties": {
        "test_runner": {
          "type": "string",
          "enum": ["jest", "pytest", "vitest", "mocha", "custom"],
          "description": "Test runner to use"
        },
        "browser_testing": {
          "type": "boolean",
          "description": "Whether to use browser testing (Puppeteer/Playwright)"
        },
        "auto_commit": {
          "type": "boolean",
          "description": "Auto-commit after verified features"
        },
        "require_tests": {
          "type": "boolean",
          "description": "Require all tests to pass before marking complete"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "tests", "implemented"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique feature identifier"
          },
          "name": {
            "type": "string",
            "description": "Human-readable feature name"
          },
          "description": {
            "type": "string",
            "description": "What this feature does"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Implementation priority (1 = highest)"
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Feature IDs this depends on"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "description", "type", "passed"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Test identifier"
                },
                "description": {
                  "type": "string",
                  "description": "What this test verifies"
                },
                "type": {
                  "type": "string",
                  "enum": ["unit", "integration", "e2e", "manual", "visual"],
                  "description": "Test type"
                },
                "command": {
                  "type": "string",
                  "description": "Command to run test (optional for manual)"
                },
                "expected": {
                  "type": "string",
                  "description": "Expected outcome"
                },
                "passed": {
                  "type": "boolean",
                  "description": "Whether test passed - MUST start false"
                },
                "last_run": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When test was last run"
                },
                "error": {
                  "type": "string",
                  "description": "Error message if failed"
                }
              }
            }
          },
          "implemented": {
            "type": "boolean",
            "description": "Whether code is written"
          },
          "verified": {
            "type": "boolean",
            "description": "Whether all tests pass"
          },
          "committed": {
            "type": "boolean",
            "description": "Whether committed to git"
          },
          "commit_hash": {
            "type": ["string", "null"],
            "description": "Git commit hash"
          },
          "notes": {
            "type": "string",
            "description": "Implementation notes"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "total_features": {"type": "integer"},
        "completed_features": {"type": "integer"},
        "completion_percentage": {"type": "number"},
        "last_updated": {"type": "string", "format": "date-time"},
        "last_feature_completed": {"type": ["string", "null"]}
      }
    }
  }
}
