{
  "dashboard": {
    "title": "GitMQ Code Transfer Performance",
    "tags": [
      "gitmq",
      "code-transfer",
      "performance"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "stat",
        "title": "Transfers (24h)",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "increase(gitmq_code_transfers_total[24h])",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Avg Transfer Size",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "avg(gitmq_code_transfer_size_bytes)",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Avg Duration",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "avg(gitmq_code_transfer_duration_seconds)",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Avg Compression Ratio",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "avg(gitmq_code_compression_ratio)",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "heatmap",
        "title": "Transfer Size Distribution",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "rate(gitmq_code_transfer_size_bytes_bucket[5m])",
            "format": "heatmap",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "dataFormat": "tsbuckets",
        "yAxis": {
          "format": "short",
          "logBase": 1
        },
        "cards": {
          "cardPadding": 2
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "colorScheme": "interpolateOranges"
        }
      },
      {
        "type": "heatmap",
        "title": "Transfer Duration Distribution",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "targets": [
          {
            "expr": "rate(gitmq_code_transfer_duration_seconds_bucket[5m])",
            "format": "heatmap",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "dataFormat": "tsbuckets",
        "yAxis": {
          "format": "short",
          "logBase": 1
        },
        "cards": {
          "cardPadding": 2
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "colorScheme": "interpolateOranges"
        }
      },
      {
        "type": "graph",
        "title": "Transfers by Method",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "expr": "rate(gitmq_code_transfers_total{method=\"inline\"}[5m])",
            "legendFormat": "Inline",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "rate(gitmq_code_transfers_total{method=\"git_bundle\"}[5m])",
            "legendFormat": "Git Bundle",
            "refId": "B",
            "datasource": "Prometheus"
          },
          {
            "expr": "rate(gitmq_code_transfers_total{method=\"git_patch\"}[5m])",
            "legendFormat": "Git Patch",
            "refId": "C",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "transfers/sec",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "graph",
        "title": "Bandwidth Usage",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "targets": [
          {
            "expr": "rate(gitmq_code_transfer_size_bytes[5m])",
            "legendFormat": "{{method}}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "bytes/sec",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "table",
        "title": "Transfer Statistics",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "gitmq_code_transfers_total",
            "format": "table",
            "instant": true,
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {}
            }
          }
        ]
      }
    ]
  }
}