{
  "dashboard": {
    "title": "GitMQ System Health",
    "tags": [
      "gitmq",
      "system",
      "health"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "type": "gauge",
        "title": "Memory Usage",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "gitmq_system_memory_usage_percent",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 70,
                  "color": "yellow"
                },
                {
                  "value": 90,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "type": "gauge",
        "title": "CPU Usage",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "gitmq_system_cpu_usage_percent",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 70,
                  "color": "yellow"
                },
                {
                  "value": 90,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "type": "gauge",
        "title": "Disk Usage",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "gitmq_system_disk_usage_percent",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 80,
                  "color": "yellow"
                },
                {
                  "value": 95,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Uptime",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "gitmq_system_uptime_seconds",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "graph",
        "title": "Error Rate by Type",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 6
        },
        "targets": [
          {
            "expr": "rate(gitmq_errors_total[5m])",
            "legendFormat": "{{error_type}}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "errors/sec",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "graph",
        "title": "Resource Usage Trend",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 6
        },
        "targets": [
          {
            "expr": "gitmq_system_memory_usage_percent",
            "legendFormat": "Memory %",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "gitmq_system_cpu_usage_percent",
            "legendFormat": "CPU %",
            "refId": "B",
            "datasource": "Prometheus"
          },
          {
            "expr": "gitmq_system_disk_usage_percent",
            "legendFormat": "Disk %",
            "refId": "C",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "percent",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "graph",
        "title": "Network I/O",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 14
        },
        "targets": [
          {
            "expr": "rate(gitmq_system_network_bytes_sent[5m])",
            "legendFormat": "Sent",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "rate(gitmq_system_network_bytes_received[5m])",
            "legendFormat": "Received",
            "refId": "B",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "bytes/sec",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "table",
        "title": "Error Breakdown",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 22
        },
        "targets": [
          {
            "expr": "gitmq_errors_total",
            "format": "table",
            "instant": true,
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {}
            }
          }
        ]
      }
    ]
  }
}