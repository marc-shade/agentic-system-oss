{
  "dashboard": {
    "title": "GitMQ Approval & Risk Assessment",
    "tags": [
      "gitmq",
      "approval",
      "risk"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "stat",
        "title": "Pending Approvals",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "gitmq_approvals_pending",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Approved (24h)",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "increase(gitmq_approval_decisions_total{decision=\"approved\"}[24h])",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Rejected (24h)",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "increase(gitmq_approval_decisions_total{decision=\"rejected\"}[24h])",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Auto-Approved (24h)",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "increase(gitmq_approval_decisions_total{decision=\"auto_approved\"}[24h])",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "graph",
        "title": "Approval Decision Time (Percentiles)",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(gitmq_approval_decision_time_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "histogram_quantile(0.90, rate(gitmq_approval_decision_time_seconds_bucket[5m]))",
            "legendFormat": "p90",
            "refId": "B",
            "datasource": "Prometheus"
          },
          {
            "expr": "histogram_quantile(0.95, rate(gitmq_approval_decision_time_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "C",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "seconds",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "graph",
        "title": "Approval Decisions",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "targets": [
          {
            "expr": "rate(gitmq_approval_decisions_total{decision=\"approved\"}[5m])",
            "legendFormat": "Approved",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "rate(gitmq_approval_decisions_total{decision=\"rejected\"}[5m])",
            "legendFormat": "Rejected",
            "refId": "B",
            "datasource": "Prometheus"
          },
          {
            "expr": "rate(gitmq_approval_decisions_total{decision=\"auto_approved\"}[5m])",
            "legendFormat": "Auto-Approved",
            "refId": "C",
            "datasource": "Prometheus"
          },
          {
            "expr": "rate(gitmq_approval_decisions_total{decision=\"timeout\"}[5m])",
            "legendFormat": "Timeout",
            "refId": "D",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "decisions/sec",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "heatmap",
        "title": "Risk Score Distribution",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "expr": "rate(gitmq_risk_score_bucket[5m])",
            "format": "heatmap",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "dataFormat": "tsbuckets",
        "yAxis": {
          "format": "short",
          "logBase": 1
        },
        "cards": {
          "cardPadding": 2
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "colorScheme": "interpolateOranges"
        }
      },
      {
        "type": "graph",
        "title": "Tasks by Risk Level",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "targets": [
          {
            "expr": "gitmq_tasks_by_risk_level{risk_level=\"low\"}",
            "legendFormat": "Low",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "gitmq_tasks_by_risk_level{risk_level=\"medium\"}",
            "legendFormat": "Medium",
            "refId": "B",
            "datasource": "Prometheus"
          },
          {
            "expr": "gitmq_tasks_by_risk_level{risk_level=\"high\"}",
            "legendFormat": "High",
            "refId": "C",
            "datasource": "Prometheus"
          },
          {
            "expr": "gitmq_tasks_by_risk_level{risk_level=\"critical\"}",
            "legendFormat": "Critical",
            "refId": "D",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "count",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "table",
        "title": "Approvals by Channel",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "gitmq_approval_decisions_total",
            "format": "table",
            "instant": true,
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {}
            }
          }
        ]
      }
    ]
  }
}