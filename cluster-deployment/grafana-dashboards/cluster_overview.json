{
  "dashboard": {
    "title": "GitMQ Cluster Overview",
    "tags": [
      "gitmq",
      "cluster",
      "overview"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "stat",
        "title": "Tasks Submitted (24h)",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "increase(gitmq_tasks_submitted_total[24h])",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Tasks Completed (24h)",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 4,
          "y": 0
        },
        "targets": [
          {
            "expr": "increase(gitmq_tasks_completed_total[24h])",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Success Rate",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 8,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(gitmq_tasks_completed_total[1h]) / rate(gitmq_tasks_submitted_total[1h]) * 100",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "gauge",
        "title": "Pending Approvals",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "gitmq_approvals_pending",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 20,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 5,
                  "color": "yellow"
                },
                {
                  "value": 10,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Active Nodes",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 16,
          "y": 0
        },
        "targets": [
          {
            "expr": "count(count by (node_id) (gitmq_tasks_submitted_total))",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Error Rate (1h)",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 20,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(gitmq_errors_total[1h]) * 3600",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "errors/h",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "type": "graph",
        "title": "Task Submission Rate",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "rate(gitmq_tasks_submitted_total[5m])",
            "legendFormat": "{{node_id}} - {{task_type}}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "tasks/sec",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "graph",
        "title": "Task Completion Rate",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "targets": [
          {
            "expr": "rate(gitmq_tasks_completed_total[5m])",
            "legendFormat": "{{node_id}} - {{task_type}}",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "rate(gitmq_tasks_failed_total[5m])",
            "legendFormat": "{{node_id}} - {{task_type}} (failed)",
            "refId": "B",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          {
            "label": "tasks/sec",
            "show": true
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "max": true,
          "min": true,
          "current": true,
          "values": true
        },
        "lines": true,
        "fill": 1,
        "linewidth": 1,
        "nullPointMode": "null",
        "tooltip": {
          "shared": true,
          "sort": 0,
          "value_type": "individual"
        }
      },
      {
        "type": "heatmap",
        "title": "Task Execution Duration Distribution",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "expr": "rate(gitmq_task_execution_duration_seconds_bucket[5m])",
            "format": "heatmap",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "dataFormat": "tsbuckets",
        "yAxis": {
          "format": "short",
          "logBase": 1
        },
        "cards": {
          "cardPadding": 2
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "colorScheme": "interpolateOranges"
        }
      },
      {
        "type": "heatmap",
        "title": "Risk Score Distribution",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "targets": [
          {
            "expr": "rate(gitmq_risk_score_bucket[5m])",
            "format": "heatmap",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "dataFormat": "tsbuckets",
        "yAxis": {
          "format": "short",
          "logBase": 1
        },
        "cards": {
          "cardPadding": 2
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "colorScheme": "interpolateOranges"
        }
      },
      {
        "type": "table",
        "title": "Recent Errors",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "topk(10, gitmq_errors_total)",
            "format": "table",
            "instant": true,
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {}
            }
          }
        ]
      }
    ]
  }
}